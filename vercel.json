{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/mobile", "destination": "/dashboard/mobile.html" },
    { "source": "/eyes", "destination": "/dashboard/mobile.html" },
    { "source": "/manifest.json", "destination": "/dashboard/manifest.json" },
    { "source": "/manifest-desktop.json", "destination": "/dashboard/manifest-desktop.json" },
    { "source": "/sw.js", "destination": "/dashboard/sw.js" },
    { "source": "/eyeballs.js", "destination": "/dashboard/eyeballs.js" },
    { "source": "/robot3d.js", "destination": "/dashboard/robot3d.js" },
    { "source": "/jarvis_hud.js", "destination": "/dashboard/jarvis_hud.js" },
    { "source": "/deskbot_render.jpg", "destination": "/dashboard/deskbot_render.jpg" },
    { "source": "/", "destination": "/dashboard/index.html" },
    { "source": "/(.*)", "destination": "/api/index.py" }
  ]
}
